{
  "name": "alpha-omega-server",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/card.mjs",
    "dev": "tsx watch src/index.ts",
    "prestart": "node ../scripts/card.mjs",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "5.8"
  }
}
